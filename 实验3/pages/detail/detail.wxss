.container { padding: 30rpx; background: #fff; min-height: 100vh; }
.title { font-size: 40rpx; font-weight: 700; line-height: 1.45; text-align: center; }
.add-date { color: #888; font-size: 26rpx; text-align: right; margin: 18rpx 0; }
.poster image { width: 700rpx; max-width: 100%; display: block; margin: 0 auto; }
.content { margin-top: 24rpx; font-size: 32rpx; line-height: 1.8; text-align: left; }
button { width: 300rpx; margin: 36rpx auto; }
.empty { padding: 80rpx; text-align: center; color: #888; }
