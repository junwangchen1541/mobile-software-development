.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx 64rpx;
}

.heading {
  margin-bottom: 36rpx;
}

.title {
  display: block;
  color: #1f2630;
  font-size: 48rpx;
  font-weight: 700;
}

.subtitle {
  display: block;
  margin-top: 14rpx;
  color: #69717d;
  font-size: 27rpx;
  line-height: 1.6;
}

.level-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.level-card {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
  box-sizing: border-box;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e4e7eb;
  border-radius: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 38, 48, 0.07);
  transition: transform 120ms ease, opacity 120ms ease;
}

.level-card-active {
  opacity: 0.84;
  transform: scale(0.98);
}

.level-image {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #d9eef5;
}

.level-meta {
  padding: 20rpx 18rpx 22rpx;
}

.level-name,
.level-action {
  display: block;
}

.level-name {
  color: #222933;
  font-size: 31rpx;
  font-weight: 650;
}

.level-action {
  margin-top: 8rpx;
  color: #e64340;
  font-size: 24rpx;
}
