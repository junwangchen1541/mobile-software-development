<view class="container"><view class="profile"><image class="avatar" src="{{user.avatarUrl}}"/><view class="profile-name">{{user.nickName}} 的个人主页</view><view class="subtitle">{{user.province}} · {{user.country}} · 共 {{photos.length}} 张图片</view></view><view class="section-title">上传历史</view><block wx:for="{{photos}}" wx:key="key"><view class="card"><navigator url="/pages/detail/detail?id={{item.key}}"><image class="photo" src="{{item.photoUrl}}" mode="aspectFill"/></navigator><view class="card-foot"><text>{{item.addDate}}</text><text>{{item.caption}}</text></view></view></block><view class="empty" wx:if="{{!photos.length}}">该用户还没有公开图片</view></view>
