<view class="container"><view class="upload-box" bindtap="chooseImage"><image wx:if="{{preview}}" class="detail-photo" src="{{preview}}" mode="aspectFit"/><view wx:else>点击此处选择图片</view></view><input class="caption-input" placeholder="写下这张照片的故事（可选）" value="{{caption}}" bindinput="onCaption"/><button class="button" bindtap="upload">上传到社区</button><view class="section-title">已上传图片历史</view><view class="history-grid"><image wx:for="{{history}}" wx:key="key" class="history-image" src="{{item.photoUrl}}" mode="aspectFill"/></view></view>
