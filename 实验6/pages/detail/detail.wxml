<view class="container" wx:if="{{photo}}"><view class="card"><view class="card-head"><image class="avatar" src="{{photo.avatarUrl}}"/><view class="user-info"><view class="nick">{{photo.nickName}}</view><view class="address">{{photo.province}} · {{photo.country}}</view></view></view><image class="detail-photo" src="{{photo.photoUrl}}" mode="aspectFit"/><view class="card-foot"><text>{{photo.addDate}}</text><text>{{photo.caption}}</text></view></view><view class="actions"><button class="button" bindtap="downloadPhoto">下载到本地</button><button class="button ghost" open-type="share">分享给好友</button><button class="button ghost" bindtap="previewPhoto">全屏预览</button></view></view>
