.editor-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  background: #f4f7f5;
}

.editor-intro {
  padding: 22rpx 8rpx 30rpx;
}

.editor-kicker {
  color: #087f78;
  font-size: 19rpx;
  font-weight: 700;
}

.editor-title {
  display: block;
  margin-top: 14rpx;
  color: #193542;
  font-size: 42rpx;
  font-weight: 700;
}

.editor-desc {
  display: block;
  margin-top: 10rpx;
  color: #7d8b8d;
  font-size: 22rpx;
  line-height: 1.6;
}

.form-card {
  padding: 30rpx 26rpx 34rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.field-group + .field-group {
  margin-top: 26rpx;
}

.field-label,
.field-hint {
  display: block;
}

.field-label {
  margin-bottom: 10rpx;
  color: #3f565c;
  font-size: 23rpx;
  font-weight: 650;
}

.field-label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.field-hint {
  color: #95a2a3;
  font-size: 19rpx;
}

.field-input,
.picker-value,
.field-textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 18rpx 20rpx;
  color: #40565c;
  background: #f4f8f6;
  border: 1rpx solid #e1eae7;
  border-radius: 6rpx;
  font-size: 23rpx;
}

.field-input,
.picker-value {
  min-height: 72rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value text {
  color: #087f78;
  font-size: 30rpx;
}

.field-textarea {
  min-height: 140rpx;
  line-height: 1.65;
}

.image-button,
.remove-image,
.submit-button {
  width: 100%;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  font-size: 23rpx;
  line-height: 78rpx;
}

.image-button {
  color: #087f78;
  background: #e8f3f0;
}

.image-preview-wrap {
  position: relative;
}

.image-preview {
  display: block;
  width: 100%;
  height: 260rpx;
  border-radius: 6rpx;
}

.remove-image {
  margin-top: 12rpx;
  color: #9b5d58;
  background: #fff0ee;
}

.submit-button {
  margin-top: 34rpx;
  color: #ffffff;
  background: #087f78;
  font-weight: 650;
}
