.detail-page {
  height: 100vh;
  background: #f4f7f5;
}

.detail-hero {
  box-sizing: border-box;
  min-height: 430rpx;
  padding: 50rpx 42rpx 48rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #ffffff;
}

.detail-icon {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 80rpx;
  text-align: center;
}

.detail-meta {
  display: flex;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.7);
  font-size: 21rpx;
}

.detail-title {
  display: block;
  margin-top: 18rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.3;
}

.detail-summary {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 24rpx;
  line-height: 1.65;
}

.detail-body {
  padding: 34rpx 30rpx 54rpx;
}

.story-section {
  position: relative;
  padding: 34rpx 32rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.learning-section {
  margin-top: 20rpx;
}

.story-index {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  color: #c4cecd;
  font-size: 22rpx;
  font-weight: 700;
}

.story-title {
  color: #193542;
  font-size: 30rpx;
  font-weight: 700;
}

.story-text {
  display: block;
  margin-top: 20rpx;
  color: #67777a;
  font-size: 25rpx;
  line-height: 1.85;
}

.feeling-card {
  margin-top: 20rpx;
  padding: 32rpx;
  background: #fff5df;
  border-radius: 8rpx;
}

.feeling-label {
  color: #bf8332;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.feeling-text {
  display: block;
  margin-top: 14rpx;
  color: #635744;
  font-size: 25rpx;
  line-height: 1.8;
}

.detail-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}

.favorite-action,
.share-action {
  flex: 1;
  height: 82rpx;
  margin: 0;
  padding: 0;
  border-radius: 6rpx;
  font-size: 23rpx;
  line-height: 82rpx;
}

.favorite-action {
  color: #087f78;
  background: #e2f3ef;
}

.favorite-active {
  color: #8a6825;
  background: #fff0c8;
}

.share-action {
  color: #ffffff;
  background: #193f54;
}
