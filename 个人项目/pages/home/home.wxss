.home-page {
  padding-top: 24rpx;
}

.hero {
  position: relative;
  box-sizing: border-box;
  height: 520rpx;
  overflow: hidden;
  padding: 50rpx 42rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #123d57 0%, #146f78 58%, #4bb7aa 100%);
  border-radius: 12rpx;
}

.sun {
  position: absolute;
  top: 58rpx;
  right: 54rpx;
  width: 120rpx;
  height: 120rpx;
  background: #f3c66d;
  border-radius: 50%;
  box-shadow: 0 0 0 24rpx rgba(243, 198, 109, 0.12), 0 0 0 52rpx rgba(243, 198, 109, 0.07);
}

.wave {
  position: absolute;
  width: 760rpx;
  height: 240rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 50%;
}

.wave-one {
  right: -330rpx;
  bottom: -110rpx;
  transform: rotate(-8deg);
}

.wave-two {
  right: -260rpx;
  bottom: -158rpx;
  transform: rotate(-8deg);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 520rpx;
  display: flex;
  flex-direction: column;
}

.hero-eyebrow {
  color: #aee9df;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-title {
  margin-top: 26rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.7;
}

.hero-button {
  width: 230rpx;
  height: 72rpx;
  margin: 30rpx 0 0;
  padding: 0;
  color: #153e55;
  background: #ffffff;
  border-radius: 6rpx;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hero-secondary {
  width: 132rpx;
  height: 72rpx;
  margin: 30rpx 0 0;
  padding: 0;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.44);
  border-radius: 6rpx;
  font-size: 21rpx;
  line-height: 70rpx;
}

.hero-date {
  position: absolute;
  right: 38rpx;
  bottom: 38rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.hero-date-number {
  font-size: 28rpx;
  font-weight: 700;
}

.hero-date-label {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 18rpx;
}

.stats-card {
  position: relative;
  z-index: 3;
  display: flex;
  margin: -34rpx 24rpx 0;
  padding: 28rpx 8rpx;
  background: #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 16rpx 38rpx rgba(23, 63, 73, 0.1);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-item + .stat-item {
  border-left: 1rpx solid #e6ecea;
}

.stat-value {
  color: #087f78;
  font-size: 35rpx;
  font-weight: 700;
}

.stat-label {
  margin-top: 7rpx;
  color: #839194;
  font-size: 19rpx;
}

.quote-card {
  position: relative;
  margin-top: 28rpx;
  padding: 30rpx 36rpx 30rpx 74rpx;
  background: #fff8e9;
  border-left: 6rpx solid #eeb75a;
  border-radius: 6rpx;
}

.quote-mark {
  position: absolute;
  left: 24rpx;
  top: 12rpx;
  color: #eeb75a;
  font-family: Georgia, serif;
  font-size: 70rpx;
}

.quote-text {
  color: #665c49;
  font-size: 24rpx;
  line-height: 1.7;
}

.featured-heading {
  margin-top: 44rpx;
}

.heading-note {
  display: block;
  margin-top: 7rpx;
  color: #91a0a2;
  font-size: 20rpx;
}

.section-link {
  color: #087f78;
  font-size: 22rpx;
}

.memory-card {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 26rpx 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
}

.memory-icon {
  width: 78rpx;
  height: 78rpx;
  flex: none;
  color: #ffffff;
  border-radius: 50%;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 78rpx;
  text-align: center;
}

.memory-copy {
  min-width: 0;
  flex: 1;
  margin-left: 22rpx;
}

.memory-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.memory-category {
  color: #087f78;
  font-size: 19rpx;
  font-weight: 600;
}

.memory-date {
  color: #a0abad;
  font-size: 19rpx;
}

.memory-title {
  display: block;
  margin-top: 8rpx;
  color: #193542;
  font-size: 27rpx;
  font-weight: 650;
}

.memory-summary {
  display: block;
  margin-top: 8rpx;
  overflow: hidden;
  color: #718083;
  font-size: 21rpx;
  line-height: 1.55;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.memory-arrow {
  margin-left: 18rpx;
  color: #b8c2c2;
  font-size: 38rpx;
}

.summary-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 32rpx;
  padding: 34rpx 32rpx;
  color: #ffffff;
  background: #193f54;
  border-radius: 8rpx;
}

.summary-kicker {
  color: #82d2c6;
  font-size: 18rpx;
  font-weight: 700;
}

.summary-title {
  display: block;
  margin-top: 8rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.summary-arrow {
  font-size: 42rpx;
}
