page {
  min-height: 100%;
  background: #f4f7f5;
  color: #193542;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 28rpx 44rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  color: #193542;
  font-size: 34rpx;
  font-weight: 700;
}

.section-caption {
  color: #91a0a2;
  font-size: 21rpx;
}
